# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/scriptoria"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="50"
MAX_PAGES="10"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

